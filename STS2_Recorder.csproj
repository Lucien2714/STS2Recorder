<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>STS2_Recorder</AssemblyName>
    <RootNamespace>STS2_Recorder</RootNamespace>
    <!-- A clean build must be warning-free; the vendored sources are held to
         the same bar as our own so a bad re-sync surfaces here too. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- Single source of truth for the mod version is mod_manifest.json. Read it
         at build time and stamp it onto the assembly so the DLL, the version
         recorded in each trajectory file, and the manifest cannot drift apart. -->
    <ModVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)mod_manifest.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</ModVersion>
    <Version>$(ModVersion)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Our copy of STS2MCP's state serializer. See vendor/README.md. -->
    <Sts2McpDir>$(MSBuildThisFileDirectory)vendor/STS2MCP</Sts2McpDir>

    <!-- Where vendor/STS2MCP was copied from. Documentation, not a build input:
         nothing reads these but a person re-syncing the copy, who should update
         both. See vendor/README.md. -->
    <Sts2McpUpstreamCommit>e759570b11f7935a6dda5adb9cd5d29be490c9a6</Sts2McpUpstreamCommit>
    <Sts2McpUpstreamRef>Lucien2714/STS2MCP@feat/post-action-state</Sts2McpUpstreamRef>
  </PropertyGroup>

  <!-- === Game assembly references ============================================
       Building requires a real Slay the Spire 2 install; there is no way to
       build in a bare checkout. Set STS2GameDir in Directory.Build.props (see
       Directory.Build.props.example) or pass -p:STS2GameDir=... -->
  <PropertyGroup>
    <STS2GameDir Condition="'$(STS2GameDir)' == ''">D:\SteamLibrary\steamapps\common\Slay the Spire 2</STS2GameDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and '$(OS)' == 'Windows_NT'">$(STS2GameDir)/data_sts2_windows_x86_64</STS2GameDataDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">$(STS2GameDir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</STS2GameDataDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and '$(OS)' != 'Windows_NT' and !$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">$(STS2GameDir)/data_sts2_linuxbsd_x86_64</STS2GameDataDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(STS2GameDataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(STS2GameDataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- === Sources =============================================================
       EnableDefaultCompileItems is off so the two source sets stay visibly
       distinct: ours under src/, and STS2MCP's under vendor/STS2MCP - a copy of
       someone else's code, kept locally so it can be fixed here. See
       vendor/README.md.

       Named one by one rather than globbed: the copy holds only the files the
       serializer actually needs, and a new file appearing there should be a
       decision someone made, not something a wildcard swept in. -->
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Compile Include="$(Sts2McpDir)/McpMod.StateBuilder.cs;$(Sts2McpDir)/McpMod.PlayerDetail.cs;$(Sts2McpDir)/McpMod.Helpers.cs;$(Sts2McpDir)/McpMod.StateBuilderSupport.cs">
      <Link>STS2MCP/%(Filename)%(Extension)</Link>
      <Visible>true</Visible>
    </Compile>
  </ItemGroup>

  <!-- === State serializer presence ===========================================
       Recordings no longer carry a state-serializer stamp: they carry the game
       version the state was read out of, which the mod reads from the game at
       load, plus this mod's own version. Neither needs a build step. -->
  <Target Name="CheckStateBuilderSources" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(Sts2McpDir)/McpMod.StateBuilder.cs')"
           Text="vendor/STS2MCP/McpMod.StateBuilder.cs is missing; the state serializer cannot be compiled. See vendor/README.md." />
    <Error Condition="!Exists('$(Sts2McpDir)/McpMod.PlayerDetail.cs')"
           Text="vendor/STS2MCP/McpMod.PlayerDetail.cs is missing; the master deck cannot be recorded. See vendor/README.md." />
  </Target>

</Project>
