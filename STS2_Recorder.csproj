<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>STS2_Recorder</AssemblyName>
    <RootNamespace>STS2_Recorder</RootNamespace>
    <!-- A clean build must be warning-free; the submodule's sources are held to
         the same bar as our own so upstream regressions surface here too. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- Single source of truth for the mod version is mod_manifest.json. Read it
         at build time and stamp it onto the assembly so the DLL, the version
         recorded in each trajectory file, and the manifest cannot drift apart. -->
    <ModVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)mod_manifest.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</ModVersion>
    <Version>$(ModVersion)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- The STS2MCP submodule holding the state serializer we compile. -->
    <Sts2McpSubmoduleDir>$(MSBuildThisFileDirectory)vendor/STS2MCP</Sts2McpSubmoduleDir>
  </PropertyGroup>

  <!-- === Game assembly references ============================================
       Building requires a real Slay the Spire 2 install; there is no way to
       build in a bare checkout. Set STS2GameDir in Directory.Build.props (see
       Directory.Build.props.example) or pass -p:STS2GameDir=... -->
  <PropertyGroup>
    <STS2GameDir Condition="'$(STS2GameDir)' == ''">D:\SteamLibrary\steamapps\common\Slay the Spire 2</STS2GameDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and '$(OS)' == 'Windows_NT'">$(STS2GameDir)/data_sts2_windows_x86_64</STS2GameDataDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">$(STS2GameDir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</STS2GameDataDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and '$(OS)' != 'Windows_NT' and !$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">$(STS2GameDir)/data_sts2_linuxbsd_x86_64</STS2GameDataDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(STS2GameDataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(STS2GameDataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- === Sources =============================================================
       EnableDefaultCompileItems is off so the two source sets stay visibly
       distinct: ours under src/, STS2MCP's own source pulled in from the
       vendor/STS2MCP submodule. See vendor/README.md.

       BuildGameState() is one method on a partial class whose pieces call
       freely across each other, so the compilable unit is nearly the whole
       class rather than one file, hence a whole-directory include with two
       deliberate exclusions:

         McpMod.cs             HttpListener + [ModInitializer]. The recorder must
                               not open a port, and two [ModInitializer] classes
                               in one DLL would both run. src/McpModShim.cs
                               re-supplies the three members the rest of the
                               class needs from it.
         McpMod.SettingsUI.cs  Harmony patches for STS2MCP's own settings panel;
                               the recorder must not alter game settings.

       The glob is non-recursive, so the submodule's own bin/ and obj/ are never
       picked up. -->
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Compile Include="$(Sts2McpSubmoduleDir)/*.cs"
             Exclude="$(Sts2McpSubmoduleDir)/McpMod.cs;$(Sts2McpSubmoduleDir)/McpMod.SettingsUI.cs">
      <Link>STS2MCP/%(Filename)%(Extension)</Link>
      <Visible>true</Visible>
    </Compile>
  </ItemGroup>

  <!-- === Submodule checkout guard ============================================
       A bare `git clone` leaves vendor/STS2MCP empty, which would otherwise
       fail as a wall of "BuildGameState does not exist" errors. -->
  <Target Name="CheckStateBuilderSubmodule" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(Sts2McpSubmoduleDir)/McpMod.StateBuilder.cs')"
           Text="The STS2MCP submodule at vendor/STS2MCP is not checked out. Run: git submodule update --init --recursive" />
  </Target>

  <!-- === State serializer provenance =========================================
       Which STS2MCP commit the state serializer was compiled from. Stamped onto
       the assembly and into every recording, so a trajectory file can always be
       traced back to the exact BuildGameState() that wrote it.

       Read from the submodule's actual checkout rather than from the gitlink,
       so a local `git checkout` inside vendor/STS2MCP is reported honestly; an
       uncommitted edit to a source file there is stamped '&lt;sha&gt;-dirty'.
       Without git (a source drop, an offline build box) the stamp degrades to
       'unknown' rather than failing the build. -->
  <Target Name="ResolveStateBuilderCommit" BeforeTargets="GetAssemblyAttributes;CoreCompile">
    <PropertyGroup>
      <_StateBuilderSha />
      <_StateBuilderShaExit />
      <_StateBuilderDirty />
    </PropertyGroup>

    <Exec Command="git -C &quot;$(Sts2McpSubmoduleDir)&quot; rev-parse HEAD"
          ConsoleToMSBuild="true" StandardOutputImportance="low"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_StateBuilderSha" />
      <Output TaskParameter="ExitCode" PropertyName="_StateBuilderShaExit" />
    </Exec>
    <Exec Command="git -C &quot;$(Sts2McpSubmoduleDir)&quot; status --porcelain -uno -- &quot;*.cs&quot;"
          Condition="'$(_StateBuilderShaExit)' == '0'"
          ConsoleToMSBuild="true" StandardOutputImportance="low"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_StateBuilderDirty" />
    </Exec>

    <PropertyGroup>
      <StateBuilderCommit>unknown</StateBuilderCommit>
      <StateBuilderCommit Condition="'$(_StateBuilderShaExit)' == '0' and '$(_StateBuilderSha)' != ''">$(_StateBuilderSha.Trim())</StateBuilderCommit>
      <StateBuilderCommit Condition="'$(StateBuilderCommit)' != 'unknown' and '$(_StateBuilderDirty.Trim())' != ''">$(StateBuilderCommit)-dirty</StateBuilderCommit>
    </PropertyGroup>

    <Warning Condition="'$(StateBuilderCommit)' == 'unknown'"
             Text="Could not read the STS2MCP submodule commit; recordings will carry state_builder_commit=unknown." />
    <Warning Condition="$(StateBuilderCommit.EndsWith('-dirty'))"
             Text="vendor/STS2MCP has uncommitted changes; recordings will be stamped $(StateBuilderCommit). Fix bugs upstream in STS2MCP and update the submodule pin instead." />

    <ItemGroup>
      <AssemblyMetadata Include="StateBuilderCommit" Value="$(StateBuilderCommit)" />
    </ItemGroup>
  </Target>

</Project>
